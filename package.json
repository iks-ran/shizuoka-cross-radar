{
  "name": "shizuoka-cross-seat-radar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "mkdir -p .tmp/vite && TMPDIR=.tmp/vite vite",
    "build": "tsc --noEmit && mkdir -p .tmp/vite && TMPDIR=.tmp/vite vite build",
    "preview": "mkdir -p .tmp/vite && TMPDIR=.tmp/vite vite preview",
    "test": "mkdir -p .tmp/vitest && TMPDIR=.tmp/vitest vitest run"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
